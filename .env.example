# ============================================================
# Jivanya Environment Configuration
# Copy this file to .env and provide your own credentials.
# Never commit .env or frontend/.env.local.
# ============================================================

# ----------------------------
# Supabase
# ----------------------------

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe Supabase publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend-only Supabase service-role key
# Never expose this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------
# Database
# ----------------------------

# PostgreSQL connection string used by the FastAPI backend
DATABASE_URL=

# ----------------------------
# Jiv / LLM
# ----------------------------

# Gemini API key used by Jiv's conversational/orchestration layer
GEMINI_API_KEY=

# Optional provider override.
# Leave blank to use the application's normal provider selection.
# Example: gemini
LLM_PROVIDER=

# Optional model override
LLM_MODEL=

# Optional generic provider API key.
# Gemini can use GEMINI_API_KEY instead.
LLM_API_KEY=

# Optional OpenAI-compatible provider base URL.
# Used by providers such as the supported local Ollama configuration.
LLM_BASE_URL=

# Optional Gemini request timeout in seconds.
# Backend default: 30
GEMINI_TIMEOUT=30

# ----------------------------
# Speech-to-Text
# ----------------------------

# Groq API key used server-side for Whisper transcription
GROQ_API_KEY=

# Groq Whisper model
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ----------------------------
# Vision
# ----------------------------

# Maximum number of vision models retained in memory.
# Backend uses its internal default when this is omitted.
VISION_MODEL_CACHE_SIZE=2

# ----------------------------
# Frontend
# ----------------------------

# Optional FastAPI backend URL.
# Leave blank for the application's default/local routing behavior.
NEXT_PUBLIC_API_URL=

# CORS
CORS_ORIGINS=
